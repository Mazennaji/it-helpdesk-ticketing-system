{
    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=HelpDeskDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
    },
    "Jwt": {
        "Issuer": "HelpDeskApi",
        "Audience": "HelpDeskClient",
        "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
        "ExpiryMinutes": 60
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "OpenAI": {
        "ClassifierModel": "gpt-4.1-nano",
        "AssistantModel": "gpt-4.1-mini",
        "MaxOutputTokens": 700
    },
    "AllowedHosts": "*"
}
